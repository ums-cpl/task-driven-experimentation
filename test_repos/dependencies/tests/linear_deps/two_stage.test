# Two-stage dependency: middle depends on base
RUN: --dry-run --include-deps tasks/middle
EXIT: 0
STDOUT:
SKIP_VERIFY_DEF=false
---
JOB	0
STAGE	0
WORKLOAD_NAME	run_tasks: .../base/...
WORKLOAD_MANAGER	.template/workload_managers/direct.sh
DEPENDS	
0	assets	tasks/base
---
JOB	1
STAGE	1
WORKLOAD_NAME	run_tasks: .../middle/...
WORKLOAD_MANAGER	.template/workload_managers/direct.sh
DEPENDS	0
0	assets	tasks/middle
END_STDOUT
