# Different WORKLOAD_NAMEs produce separate JOB blocks
RUN: --dry-run tasks/default_name tasks/custom_name
EXIT: 0
STDOUT:
SKIP_VERIFY_DEF=false
---
JOB	0
STAGE	0
WORKLOAD_NAME	run_tasks
WORKLOAD_MANAGER	.template/workload_managers/direct.sh
DEPENDS	
0	assets	tasks/default_name
---
JOB	1
STAGE	0
WORKLOAD_NAME	my_custom_job
WORKLOAD_MANAGER	.template/workload_managers/direct.sh
DEPENDS	
0	assets	tasks/custom_name
END_STDOUT
