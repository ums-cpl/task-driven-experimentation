# --direct sets RUN_WORKLOAD_MANAGER to the template direct workload manager (manifest records override)
RUN_TASKS: --dry-run --direct tasks/direct_task
EXIT: 0
STDOUT:
Discovering task runs...
SKIP_VERIFY_DEF=false
---
JOB	0
STAGE	0
WORKLOAD_NAME	run_tasks
WORKLOAD_MANAGER	.template/workload_managers/direct.sh
DEPENDS	
0	assets	tasks/direct_task	RUN_WORKLOAD_MANAGER=.template/workload_managers/direct.sh
END_STDOUT
