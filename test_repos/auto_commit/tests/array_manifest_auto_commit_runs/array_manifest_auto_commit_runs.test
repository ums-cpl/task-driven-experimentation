# Manifest AUTO_COMMIT=true: array entrypoint runs the task and can auto-commit when git identity is valid
RUN: git -C "$TEST_WORKDIR" init -b main && git -C "$TEST_WORKDIR" config user.name "T" && git -C "$TEST_WORKDIR" config user.email "t@e" && git -C "$TEST_WORKDIR" commit --allow-empty -m "seed"
EXIT: 0
RUN_TASKS: --array-manifest=$TEST_WORKDIR/assets/manifest_array_auto_commit --array-job-id=0 --array-task-id=0
EXIT: 0
FILE_EXISTS: $TASKS/trivial/assets/.run_success
RUN: test "$(git -C "$TEST_WORKDIR" rev-list --count HEAD)" -ge 2
EXIT: 0
