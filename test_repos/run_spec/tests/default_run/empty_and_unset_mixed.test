# Empty TASK_RUNS skips that task; unset TASK_RUNS still defaults to "assets"
RUN_TASKS: --dry-run tasks/empty_runs tasks/simple
EXIT: 0
STDOUT:
Discovering task runs...
SKIP_VERIFY_DEF=false
---
JOB	0
STAGE	0
WORKLOAD_NAME	run_tasks
WORKLOAD_MANAGER	.template/workload_managers/direct.sh
DEPENDS	
0	assets	tasks/simple
END_STDOUT
