# Cartesian product of two brace patterns
RUN_TASKS: --dry-run "tasks/simple:{a,b}-{1:2}"
EXIT: 0
STDOUT:
Discovering task runs...
SKIP_VERIFY_DEF=false
---
JOB	0
STAGE	0
WORKLOAD_NAME	run_tasks
WORKLOAD_MANAGER	.template/workload_managers/direct.sh
DEPENDS	
0	a-1	tasks/simple	TASK_RUNS={a,b}-{1:2}
1	a-2	tasks/simple	TASK_RUNS={a,b}-{1:2}
2	b-1	tasks/simple	TASK_RUNS={a,b}-{1:2}
3	b-2	tasks/simple	TASK_RUNS={a,b}-{1:2}
END_STDOUT
