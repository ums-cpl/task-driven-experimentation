# Empty strings are allowed in brace lists
RUN_TASKS: --dry-run "tasks/simple:{,a}" "tasks/simple:b{,c}"
EXIT: 0
STDOUT:
Discovering task runs...
SKIP_VERIFY_DEF=false
---
JOB	0
STAGE	0
WORKLOAD_NAME	run_tasks
WORKLOAD_MANAGER	.template/workload_managers/direct.sh
DEPENDS	
0	a	tasks/simple	TASK_RUNS={,a}
1	b	tasks/simple	TASK_RUNS=b{,c}
2	bc	tasks/simple	TASK_RUNS=b{,c}
END_STDOUT

