# Excluding a run and re-adding it later includes it again
RUN_TASKS: --dry-run tasks/with_runs:run-1 --exclude tasks/with_runs:run-1 tasks/with_runs:run-1
EXIT: 0
STDOUT:
Discovering task runs...
SKIP_VERIFY_DEF=false
---
JOB	0
STAGE	0
WORKLOAD_NAME	run_tasks
WORKLOAD_MANAGER	.template/workload_managers/direct.sh
DEPENDS	
0	run-1	tasks/with_runs	TASK_RUNS=run-1
END_STDOUT
