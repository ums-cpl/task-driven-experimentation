# Double-star exclude should match across path segments for a specific task
RUN_TASKS: --dry-run tasks/simple tasks/with_runs --exclude "tasks/**/with_runs"
EXIT: 0
STDOUT:
Discovering task runs...
SKIP_VERIFY_DEF=false
