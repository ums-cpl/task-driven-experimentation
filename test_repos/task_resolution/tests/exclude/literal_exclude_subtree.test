# Literal --exclude of a task directory (has run.sh) removes that task and all
# descendant tasks under it - same subtree semantics as excluding a matched
# parent segment via globs (e.g. tasks/**/my_tasks). The nested task is listed
# explicitly so the manifest would include it without subtree exclude logic.
RUN_TASKS: --dry-run tasks/literal_exclude_root/nested tasks/literal_exclude_root tasks/literal_exclude_sibling --exclude tasks/literal_exclude_root
EXIT: 0
STDOUT:
Discovering task runs...
SKIP_VERIFY_DEF=false
---
JOB	0
STAGE	0
WORKLOAD_NAME	run_tasks
WORKLOAD_MANAGER	.template/workload_managers/direct.sh
DEPENDS	
0	assets	tasks/literal_exclude_sibling
END_STDOUT
