# TASK_FOLDER should be available in task_meta.sh; TASK_FOLDER and RUN_FOLDER should be available in run_meta.sh/run_deps.sh.
RUN: --dry-run --include-deps tasks/path_vars
EXIT: 0
STDOUT:
Discovering task runs...
SKIP_VERIFY_DEF=false
---
JOB	0
STAGE	0
WORKLOAD_NAME	run_tasks: dep
WORKLOAD_MANAGER	.template/workload_managers/direct.sh
DEPENDS	
0	assets	tasks/dep
---
JOB	1
STAGE	1
WORKLOAD_NAME	path-vars-ok: path_vars
WORKLOAD_MANAGER	.template/workload_managers/direct.sh
DEPENDS	0
0	vars-ok	tasks/path_vars
END_STDOUT
