---
JOB	1
STAGE	1
WORKLOAD_NAME	run_tasks: path_vars_dep
WORKLOAD_MANAGER	.template/workload_managers/direct.sh
DEPENDS	0
0	second	tasks/path_vars_dep
END_STDOUT
