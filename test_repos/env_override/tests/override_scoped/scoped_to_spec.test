# Overrides accumulate across task specs
RUN_TASKS: --dry-run FOO=bar tasks/alpha BAZ=qux tasks/beta
EXIT: 0
STDOUT:
Discovering task runs...
SKIP_VERIFY_DEF=false
---
JOB	0
STAGE	0
WORKLOAD_NAME	run_tasks: tasks/*
WORKLOAD_MANAGER	.template/workload_managers/direct.sh
DEPENDS	
0	assets	tasks/alpha	FOO=bar
1	assets	tasks/beta	FOO=bar	BAZ=qux
END_STDOUT
