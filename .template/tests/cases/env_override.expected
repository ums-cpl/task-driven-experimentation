# KEY=VALUE env overrides appear in manifest (per-task, on task line)
--dry-run FOO=bar tasks/build/containers/gcc
EXPECT_SUCCESS:
SKIP_VERIFY_DEF=false
---
JOB	0
STAGE	0
WORKLOAD_NAME	run_tasks
WORKLOAD_MANAGER	.template/workload_managers/direct.sh
DEPENDS	
0	assets	tasks/build/containers/gcc	FOO=bar
