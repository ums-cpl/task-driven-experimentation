# TASK_RUNS brace expansion: {a,b}-{1:2} -> cartesian product a-1, a-2, b-1, b-2
--dry-run tasks/build/containers/gcc:{a,b}-{1:2}
EXPECT_SUCCESS:
SKIP_VERIFY_DEF=false
---
JOB	0
STAGE	0
JOB_NAME	run_tasks
WORKLOAD_MANAGER	workload_managers/direct.sh
DEPENDS	
0	a-1	tasks/build/containers/gcc	TASK_RUNS={a,b}-{1:2}
1	a-2	tasks/build/containers/gcc	TASK_RUNS={a,b}-{1:2}
2	b-1	tasks/build/containers/gcc	TASK_RUNS={a,b}-{1:2}
3	b-2	tasks/build/containers/gcc	TASK_RUNS={a,b}-{1:2}
